<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TDE03.View.CadastroComprasPage"
             Title="Cadastro de Compras">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="Cadastro de Compras" FontSize="24" FontAttributes="Bold" />
            <Label Text="ID da Compra:" />
            <HorizontalStackLayout Spacing="8">
                <Entry x:Name="txID" Placeholder="Código" HorizontalOptions="FillAndExpand" />
                <Button Text="Consultar" Clicked="btConsultar_Clicked" />
                <Button Text="Limpar" Clicked="btLimpar_Clicked" />
            </HorizontalStackLayout>
            <Label Text="Data da Compra (AAAA-MM-DD):" /><Entry x:Name="txData" Placeholder="2026-11-04" />
            <Label Text="Código do Cliente:" /><Entry x:Name="txCliente" Placeholder="ID do cliente" />
            <Label x:Name="lbTotal" Text="Total calculado pelos itens: R$ 0,00" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="Incluir" Clicked="btIncluir_Clicked" /><Button Text="Alterar" Clicked="btAlterar_Clicked" /><Button Text="Excluir" Clicked="btExcluir_Clicked" />
            </HorizontalStackLayout>
            <SearchBar x:Name="sbBusca" Placeholder="Buscar compra" TextChanged="sbBusca_TextChanged" />
            <CollectionView x:Name="lvCompras" SelectionMode="Single" SelectionChanged="lvCompras_SelectionChanged">
                <CollectionView.ItemTemplate><DataTemplate>
                    <Border Padding="10" Margin="2" Stroke="#CCCCCC" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontAttributes="Bold" />
                            <Label Text="{Binding DataCompra, StringFormat='Data: {0:dd/MM/yyyy}'}" />
                            <Label Text="{Binding CodigoCliente, StringFormat='Cliente: {0}'}" />
                            <Label Text="{Binding ValorTotal, StringFormat='Total: {0:C}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate></CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
