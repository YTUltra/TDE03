<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TDE03.View.ConfiguracaoPage"
             Title="Configuração">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Firebase Realtime Database" FontSize="24" FontAttributes="Bold" />
        <Label Text="Cole a URL base do Realtime Database (sem barra final)." />
        <Entry x:Name="txUrl" Placeholder="https://seu-projeto-default-rtdb.firebaseio.com" Keyboard="Url" />
        <Button Text="Salvar URL" Clicked="btSalvar_Clicked" />
    </VerticalStackLayout>
</ContentPage>
